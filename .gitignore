dist/

# Runtime reel jobs are entirely local. The reusable scaffold lives in templates/reel/.
projects/**
!projects/.gitkeep

# Remotion's temporary public staging area.
public/jobs/**
!public/jobs/.gitkeep

# Local licensed LUT/PDF library. The tracked catalog retains checksums and semantics.
library/luts/**/*.cube
library/guides/**/*.pdf
