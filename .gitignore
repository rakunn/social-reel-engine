.DS_Store
node_modules/
.venv/
__pycache__/
*.py[cod]
.cache/
coverage/
dist/

# One-off local exports and scratch media. Runtime project artifacts are covered below.
/output/
/work/
/jobs/
/videos/
/previews/
/renders/

# Runtime reel jobs are entirely local. The reusable scaffold lives in templates/reel/.
projects/**
!projects/.gitkeep

# Remotion's temporary public staging area.
public/jobs/**
!public/jobs/.gitkeep

# Local licensed LUT/PDF library. The tracked catalog retains checksums and semantics.
library/luts/**/*.cube
library/guides/**/*.pdf

# Checksum-pinned Google Fonts are downloaded into a local cache.
library/fonts/**/*.ttf
!library/fonts/.gitkeep
